# Variables de entorno de curado-fibra.
#
# Uso local: copiar este archivo como ".env" (está en .gitignore) y completar los valores.
# En el servidor: cargar estas mismas variables en Portainer, en el stack
# curado-fibra -> "Environment variables". Nunca escribir contraseñas en el repo.

# --- Administrador inicial y sesiones ---
# ADMIN_USER / ADMIN_PASS solo se usan la primera vez, cuando la base no tiene
# ningún administrador. Si ADMIN_PASS queda vacía se genera una contraseña al
# azar y se muestra una sola vez en el log (no hay contraseña por defecto).
# SESSION_SECRET: texto largo al azar, por ejemplo con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Si queda vacío se genera uno en cada arranque.
ADMIN_USER=admin
ADMIN_PASS=
SESSION_SECRET=

# --- Visor de Ensayos PH (SQL Server, solo lectura) ---
PH_SQL_SERVER=10.106.100.15
PH_SQL_INSTANCE=automatizacion
PH_SQL_DATABASE=Automatizacion
PH_SQL_USER=portal_lectura
PH_SQL_PASSWORD=

# --- Guardado de los ensayos de presión (SQL Server, con escritura) ---
# Mismo servidor y base que arriba. Tablas: Bursting_Maestro y Bursting_Detalle.
ENSAYOS_SQL_USER=
ENSAYOS_SQL_PASSWORD=
